<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">
    <springProperty scope="context" name="appName" source="app.name" defaultValue="verniq-api"/>
    <springProperty scope="context" name="appEnv" source="app.environment" defaultValue="development"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) [service=${appName},env=${appEnv},reqId=%X{requestId:-NO_REQ_ID},subId=%X{submissionId:--},jobId=%X{judgeJobId:--}] %cyan(%logger{36}) - %msg%n%throwable</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Specific Log Levels -->
    <logger name="com.verniq.api" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.hibernate.SQL" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
