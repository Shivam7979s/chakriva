{
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/ai/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/api/v1/ai/roadmap/interpret",
      "destination": "/api/roadmap-interpret"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "http://chakriva-api-alb-627268914.ap-south-1.elb.amazonaws.com/api/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
