{
  "name": "verniq-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "VERNIQ — Production-grade engineering learning and career platform",
  "workspaces": [
    "frontend",
    "backend/*"
  ],
  "scripts": {
    "dev": "npm --workspace=frontend run dev",
    "build": "npm --workspace=frontend run build",
    "lint": "npm --workspace=frontend run lint",
    "typecheck": "npm --workspace=frontend run typecheck",
    "dataset:check": "python -m backend.importer.cli check-dirs",
    "dataset:validate": "python -m backend.importer.cli validate",
    "dataset:report": "python -m backend.importer.cli report",
    "curriculum:audit": "node --experimental-strip-types scripts/audit_curriculum_catalog.mjs",
    "test:curriculum": "node --experimental-strip-types frontend/src/tests/curriculumCatalogReadiness.test.mjs"
  },
  "keywords": [
    "verniq",
    "engineering",
    "learning-platform",
    "dsa",
    "code-judge",
    "system-design"
  ],
  "author": "VERNIQ Core Engineering Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "framer-motion": "^14.1.0",
    "gsap": "^3.15.0",
    "liquid-gl": "^3.0.0",
    "motion": "^14.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0"
  }
}
